{
  "name": "weave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "api:check": "deno check --config supabase/functions/api/deno.json supabase/functions/api/index.ts",
    "mock-api": "pnpm --filter @weave/mock-api start",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:hardcode"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "hono": "4.13.14",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
